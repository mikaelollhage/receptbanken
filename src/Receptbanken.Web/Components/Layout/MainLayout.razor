@inherits LayoutComponentBase
@implements IDisposable
@inject AppNotificationService NotificationService
@inject NavigationManager Navigation

<FluentDesignTheme Mode="DesignThemeModes.Dark" />
<FluentDialogProvider />

<div class="app-container">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <div class="app-main">
        @if (NotificationService.HasNotification)
        {
            var bannerClass = NotificationService.IsSuccess ? "app-top-banner-success" : (NotificationService.IsError ? "app-top-banner-error" : "app-top-banner-warning");
            var icon = NotificationService.IsSuccess ? "✓" : (NotificationService.IsError ? "✕" : "⚠");
            var bannerRole = NotificationService.IsError ? "alert" : "status";
            <div class="app-top-banner @bannerClass" role="@bannerRole">
                <div class="app-top-banner-content">
                    <span class="app-top-banner-icon" aria-hidden="true">@icon</span>
                    <div class="app-top-banner-text">
                        <div class="app-top-banner-title">@NotificationService.Title</div>
                        <div class="app-top-banner-desc">@NotificationService.Message</div>
                    </div>
                </div>
                <button type="button" class="app-top-banner-close" @onclick="NotificationService.Clear" aria-label="Stäng meddelande" title="Stäng meddelande">
                    ✕ Stäng
                </button>
            </div>
        }

        <header class="app-header">
            <div style="display: flex; align-items: center; gap: 12px;">
                <a href="/recept/ny" class="btn-primary-custom" style="padding: 6px 14px; font-size: 13px;">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Color="Color.Fill" /> Nytt recept
                </a>
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ett fel har inträffat.
    <a href="." class="reload">Ladda om</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        NotificationService.OnChange += OnNotificationChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnNotificationChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (NotificationService.HasNotification)
        {
            NotificationService.Clear();
        }
    }

    public void Dispose()
    {
        NotificationService.OnChange -= OnNotificationChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
