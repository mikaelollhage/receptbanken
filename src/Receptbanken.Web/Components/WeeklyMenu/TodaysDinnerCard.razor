@using Receptbanken.Infrastructure.Services

@if (ActiveRecipe != null)
{
    var recipe = ActiveRecipe;
    var servings = ActiveServings > 0 ? ActiveServings : recipe.Servings;
    var dayHeader = CalendarWeek.FormatDayHeaderSwedish(ActiveDate);

    <section class="todays-dinner-card" aria-label="Dagens middag">
        <div class="todays-dinner-content">
            <div class="todays-dinner-badge-row">
                <span class="todays-dinner-label">🍽️ DAGENS MIDDAG</span>
                <span class="todays-dinner-date">@dayHeader</span>
                @if (IsDraft)
                {
                    <span class="weekly-status-badge status-draft">📝 Planerat i utkast</span>
                }
                else if (IsConfirmed)
                {
                    <span class="weekly-status-badge status-confirmed">📌 Spikad meny</span>
                }
            </div>

            <h2 class="todays-dinner-title">
                <a href="@($"/recept/{recipe.Id}")" class="todays-dinner-title-link">@recipe.Title</a>
            </h2>

            <div class="todays-dinner-meta">
                @if (recipe.TotalTimeMinutes.HasValue)
                {
                    <span>⏱️ @recipe.TotalTimeMinutes minuter</span>
                    <span class="todays-dinner-dot">·</span>
                }
                <span>👥 @servings @recipe.ServingsUnit</span>
                @if (recipe.RecipeCategories.Count > 0)
                {
                    <span class="todays-dinner-dot">·</span>
                    <span>@string.Join(", ", recipe.RecipeCategories.Select(rc => rc.Category.Name))</span>
                }
            </div>

            <div class="todays-dinner-actions">
                <a href="@($"/recept/{recipe.Id}/laga?portioner={servings}")" class="btn-primary-custom todays-dinner-cook-btn">
                    👨‍🍳 Starta matlagningsläge
                </a>
                <a href="@($"/recept/{recipe.Id}")" class="btn-secondary-custom todays-dinner-view-btn">
                    Visa recept
                </a>
            </div>

            <div class="todays-dinner-footer">
                @if (IsDraft)
                {
                    <a href="/veckomeny" class="todays-dinner-week-link">
                        Planeringen är ett utkast · Spika menyn i veckomenyn →
                    </a>
                }
                else
                {
                    <a href="@($"/veckomeny?datum={ActiveDate:yyyy-MM-dd}")" class="todays-dinner-week-link">
                        Vecka @ActiveWeek.IsoWeek · Visa hela veckomenyn →
                    </a>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(recipe.ImagePath) && !imageLoadFailed)
        {
            <div class="todays-dinner-image-wrap">
                <img src="@($"/{recipe.ImagePath}")" alt="@recipe.Title" class="todays-dinner-image" @onerror="() => imageLoadFailed = true" />
            </div>
        }
    </section>
}
else if (ShowDiscreetLink)
{
    var weekNumber = ActiveWeek.IsoWeek;
    <div class="todays-dinner-discreet">
        <a href="/veckomeny" class="todays-dinner-discreet-link">
            <span>📅 Vecka @weekNumber · Planera eller visa veckomenyn →</span>
        </a>
    </div>
}

@code {
    [Parameter] public PlannedDayMealDto? Meal { get; set; }
    [Parameter] public TodaysDinnerDto? Dinner { get; set; }
    [Parameter] public bool ShowDiscreetLink { get; set; } = true;

    private bool imageLoadFailed = false;

    private Recipe? ActiveRecipe => Meal?.Recipe ?? (Dinner != null && Dinner.HasConfirmedMenu ? Dinner.Recipe : null);
    private int ActiveServings => Meal?.Servings ?? (Dinner?.Servings ?? 4);
    private DateOnly ActiveDate => Meal?.Date ?? (Dinner?.LocalDate ?? DateOnly.FromDateTime(DateTime.Today));
    private CalendarWeek ActiveWeek => Meal?.CalendarWeek ?? (Dinner?.CalendarWeek ?? CalendarWeek.FromDate(ActiveDate));
    private bool IsDraft => Meal?.IsDraft == true;
    private bool IsConfirmed => Meal?.IsConfirmed == true || (Dinner != null && Dinner.HasConfirmedMenu);
}
