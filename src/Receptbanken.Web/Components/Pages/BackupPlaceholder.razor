@page "/backup"
@inject IBackupService BackupService
@inject IJSRuntime JSRuntime
@inject ILogger<BackupPlaceholder> Logger

<PageTitle>Säkerhetskopiering — Receptbanken</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">💾 Säkerhetskopiering & Återställning</h1>
        <p class="page-subtitle">Exportera hela din receptsamling, kategorier, inköpslista och lokala matbilder till en portabel ZIP-fil.</p>
    </div>
</div>

<div class="recipe-detail-grid">
    <div class="detail-card">
        <div class="detail-card-title">
            <span>📦 Exportera säkerhetskopia</span>
        </div>

        <p style="font-size: 14px; color: var(--rb-text-secondary); margin-bottom: 20px; line-height: 1.6;">
            Skapar ett komplett ZIP-arkiv med <code>manifest.json</code>, <code>data.json</code> (alla recept, ingredienser, instruktioner, kategorier och inköpslista) samt alla uppladdade och importerade bilder i <code>images/recipes/</code>.
        </p>

        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <button type="button"
                    class="btn-primary-custom"
                    disabled="@isExporting"
                    @onclick="ExportBackupAsync">
                @if (isExporting)
                {
                    <span>Skapar arkiv...</span>
                }
                else
                {
                    <span>⬇️ Ladda ner säkerhetskopia (.zip)</span>
                }
            </button>
        </div>

        <ContextualFeedback State="exportFeedback" CssClass="backup-export-feedback" />
    </div>

    <div class="detail-card">
        <div class="detail-card-title">
            <span>♻️ Återställ från säkerhetskopia</span>
        </div>

        <p style="font-size: 14px; color: var(--rb-text-secondary); margin-bottom: 16px; line-height: 1.6;">
            Välj en tidigare exporterad <code>.zip</code>-fil från Receptbanken. Återställningen utförs transaktionellt med automatisk rollback och skuggkopiering av bildmappen om något fel skulle inträffa.
        </p>

        <div class="form-group">
            <label class="form-label">Återställningsläge</label>
            <div style="display: flex; gap: 16px; margin-top: 6px;">
                <label style="display: flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer;">
                    <input type="radio" name="restoreMode" checked="@replaceExisting" @onchange="@(() => replaceExisting = true)" />
                    <span>Ersätt befintlig samling helt</span>
                </label>
                <label style="display: flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer;">
                    <input type="radio" name="restoreMode" checked="@(!replaceExisting)" @onchange="@(() => replaceExisting = false)" />
                    <span>Slå samman (behåll befintliga recept)</span>
                </label>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Välj säkerhetskopia (.zip, max 100 MB)</label>
            <InputFile OnChange="HandleBackupFileSelected" accept=".zip,application/zip" class="form-input-custom" />
        </div>

        <ContextualFeedback State="restoreFeedback" CssClass="backup-restore-feedback" />

        @if (selectedFile != null)
        {
            <div style="margin-top: 16px;">
                <button type="button"
                        class="btn-primary-custom"
                        disabled="@isRestoring"
                        @onclick="@(() => showRestoreConfirm = true)">
                    @if (isRestoring)
                    {
                        <span>Återställer säkerhetskopia...</span>
                    }
                    else
                    {
                        <span>🚀 Starta återställning (@selectedFile.Name)</span>
                    }
                </button>
            </div>
        }
    </div>
</div>

<ConfirmDialog IsVisible="showRestoreConfirm"
               Title="Bekräfta återställning av säkerhetskopia"
               Message="@(replaceExisting
                   ? "Är du säker? Alla nuvarande recept, kategorier och bilder kommer att ersättas med innehållet i säkerhetskopian."
                   : "Vill du importera recept och bilder från säkerhetskopian till din befintliga samling?")"
               ConfirmText="Ja, återställ nu"
               CancelText="Avbryt"
               OnConfirm="ExecuteRestoreAsync"
               OnCancel="@(() => showRestoreConfirm = false)" />

@code {
    private const long MaxUploadSize = 100L * 1024 * 1024; // 100 MB
    private IBrowserFile? selectedFile;
    private bool replaceExisting = true;
    private bool isExporting = false;
    private bool isRestoring = false;
    private bool showRestoreConfirm = false;

    private readonly FeedbackState exportFeedback = new();
    private readonly FeedbackState restoreFeedback = new();

    private async Task ExportBackupAsync()
    {
        isExporting = true;
        exportFeedback.Clear();

        try
        {
            var zipBytes = await BackupService.CreateBackupArchiveAsync();
            var fileName = $"receptbanken-backup-{DateTime.Now:yyyyMMdd-HHmm}.zip";
            var base64 = Convert.ToBase64String(zipBytes);
            await JSRuntime.InvokeVoidAsync("receptbanken.downloadFileFromBytes", fileName, "application/zip", base64);
            exportFeedback.ShowSuccess("Säkerhetskopian har skapats och laddats ner.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fel vid export av säkerhetskopia.");
            exportFeedback.ShowError($"Exporten misslyckades: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private void HandleBackupFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        restoreFeedback.Clear();
    }

    private async Task ExecuteRestoreAsync()
    {
        showRestoreConfirm = false;
        if (selectedFile == null)
            return;

        isRestoring = true;
        restoreFeedback.Clear();

        try
        {
            await using var stream = selectedFile.OpenReadStream(MaxUploadSize);
            var result = await BackupService.RestoreFromArchiveAsync(stream, replaceExisting);

            if (result.Success)
            {
                restoreFeedback.ShowSuccess($"Återställningen lyckades! {result.RestoredRecipes} recept, {result.RestoredCategories} kategorier och {result.RestoredImages} bilder återställdes.");
                selectedFile = null;
            }
            else
            {
                restoreFeedback.ShowError(result.ErrorMessage ?? "Återställningen misslyckades.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fel vid återställning av säkerhetskopia.");
            restoreFeedback.ShowError($"Ett fel uppstod vid läsning av filen: {ex.Message}");
        }
        finally
        {
            isRestoring = false;
        }
    }
}
