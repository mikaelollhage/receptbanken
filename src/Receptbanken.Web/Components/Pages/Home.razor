@page "/"
@implements IDisposable
@using System.Globalization
@using Receptbanken.Infrastructure.Services
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Dagens middag — Receptbanken</PageTitle>

<div class="page-header home-page-header">
    <div>
        <h1 class="page-title">Dagens middag</h1>
        <p class="page-subtitle">@GetFormattedDateSubtitle()</p>
    </div>
</div>

@if (isLoading)
{
    <div style="display: flex; justify-content: center; padding: 60px;">
        <FluentProgressRing />
    </div>
}
else if (mealPlan != null)
{
    @if (mealPlan.TodayMeal.HasRecipe)
    {
        <!-- Primärt område: Dagens rätt -->
        <TodaysDinnerCard Meal="mealPlan.TodayMeal" ShowDiscreetLink="false" />
    }
    else if (mealPlan.TodayMeal.HasSavedMenu)
    {
        <!-- Tomt läge B: Veckomeny finns men ingen rätt vald för idag -->
        <div class="empty-state home-empty-state" role="status">
            <div class="empty-state-icon">🥗</div>
            <h2 class="empty-state-title">Ingen middag planerad för idag</h2>
            <p class="empty-state-desc">
                Välj en rätt i veckomenyn eller hitta inspiration bland dina recept.
            </p>
            <div class="home-empty-actions">
                <a href="/veckomeny" class="btn-primary-custom" id="home-empty-choose-menu-btn">
                    Välj rätt i veckomenyn
                </a>
                <a href="/recept" class="btn-secondary-custom" id="home-empty-browse-recipes-btn">
                    Bläddra bland recept
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Tomt läge A: Ingen veckomeny för aktuell vecka -->
        <div class="empty-state home-empty-state" role="status">
            <div class="empty-state-icon">📅</div>
            <h2 class="empty-state-title">Dags att planera veckan?</h2>
            <p class="empty-state-desc">
                Det finns ingen veckomeny sparad för den här veckan.
            </p>
            <div class="home-empty-actions">
                <a href="/veckomeny" class="btn-primary-custom" id="home-empty-plan-week-btn">
                    Öppna veckomenyn
                </a>
                <a href="/recept" class="btn-secondary-custom" id="home-empty-browse-recipes-btn">
                    Bläddra bland recept
                </a>
            </div>
        </div>
    }

    <!-- Sekundärt område: Morgondagens rätt (kompakt remsa/kort) -->
    @if (mealPlan.TomorrowMeal.HasRecipe)
    {
        var tomorrowRecipe = mealPlan.TomorrowMeal.Recipe!;
        var tomorrowServings = mealPlan.TomorrowMeal.Servings > 0 ? mealPlan.TomorrowMeal.Servings : tomorrowRecipe.Servings;
        var tomorrowDayName = CalendarWeek.GetSwedishDayName(mealPlan.TomorrowMeal.Date);
        var tomorrowDateFormatted = mealPlan.TomorrowMeal.Date.ToString("d MMMM", SwedishCulture);

        <section class="home-tomorrow-card" aria-label="Morgondagens måltid">
            <div class="home-tomorrow-header">
                <span class="home-tomorrow-badge">🌅 I MORGON</span>
                <span class="home-tomorrow-date">@tomorrowDayName @tomorrowDateFormatted</span>
                @if (mealPlan.TomorrowMeal.IsDraft)
                {
                    <span class="weekly-status-badge status-draft" style="font-size: 11px; padding: 2px 8px;">Utkast</span>
                }
            </div>
            <div class="home-tomorrow-body">
                <div class="home-tomorrow-info">
                    <a href="@($"/recept/{tomorrowRecipe.Id}")" class="home-tomorrow-title-link">
                        @tomorrowRecipe.Title
                    </a>
                    <div class="home-tomorrow-meta">
                        @if (tomorrowRecipe.TotalTimeMinutes.HasValue)
                        {
                            <span>⏱️ @tomorrowRecipe.TotalTimeMinutes min</span>
                            <span class="todays-dinner-dot">·</span>
                        }
                        <span>👥 @tomorrowServings @tomorrowRecipe.ServingsUnit</span>
                    </div>
                </div>
                <a href="@($"/recept/{tomorrowRecipe.Id}")" class="btn-secondary-custom btn-sm home-tomorrow-btn">
                    Visa recept →
                </a>
            </div>
        </section>
    }

    <!-- Tertiärt område: Genvägar -->
    <section class="home-shortcuts-section" aria-label="Snabbval">
        <h3 class="home-shortcuts-heading">Snabbval i vardagen</h3>
        <div class="home-shortcuts-grid">
            <a href="/veckomeny" class="home-shortcut-card" id="home-shortcut-weekly-menu">
                <span class="home-shortcut-icon" aria-hidden="true">📅</span>
                <div class="home-shortcut-text">
                    <span class="home-shortcut-title">Veckomeny</span>
                    <span class="home-shortcut-desc">Planera och spika veckans måltider</span>
                </div>
                <span class="home-shortcut-arrow" aria-hidden="true">→</span>
            </a>
            <a href="/inkopslista" class="home-shortcut-card" id="home-shortcut-shopping-list">
                <span class="home-shortcut-icon" aria-hidden="true">🛒</span>
                <div class="home-shortcut-text">
                    <span class="home-shortcut-title">Inköpslista</span>
                    <span class="home-shortcut-desc">Hantera och bocka av dina inköp</span>
                </div>
                <span class="home-shortcut-arrow" aria-hidden="true">→</span>
            </a>
            <a href="/recept" class="home-shortcut-card" id="home-shortcut-recipes">
                <span class="home-shortcut-icon" aria-hidden="true">🍳</span>
                <div class="home-shortcut-text">
                    <span class="home-shortcut-title">Recept</span>
                    <span class="home-shortcut-desc">Sök, filtrera och hitta nya favoriter</span>
                </div>
                <span class="home-shortcut-arrow" aria-hidden="true">→</span>
            </a>
        </div>
    </section>
}

@code {
    private static readonly CultureInfo SwedishCulture = CultureInfo.GetCultureInfo("sv-SE");

    private HomeMealPlanDto? mealPlan;
    private DateOnly currentLocalToday;
    private bool isLoading = true;
    private CancellationTokenSource? _midnightWatcherCts;

    protected override async Task OnInitializedAsync()
    {
        var localDateProvider = ServiceProvider.GetService<ILocalDateProvider>() ?? new SwedishLocalDateProvider();
        currentLocalToday = localDateProvider.GetLocalToday();
        await LoadDataAsync();

        _midnightWatcherCts = new CancellationTokenSource();
        _ = StartMidnightWatcherAsync(_midnightWatcherCts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var clientDateStr = await JSRuntime.InvokeAsync<string?>("receptbanken.getClientLocalDate");
                if (DateOnly.TryParseExact(clientDateStr, "yyyy-MM-dd", out var clientDate))
                {
                    var localDateProvider = ServiceProvider.GetService<ILocalDateProvider>();
                    var currentLocal = localDateProvider?.GetLocalToday();
                    localDateProvider?.SetClientLocalDate(clientDate);

                    if (currentLocal != clientDate)
                    {
                        currentLocalToday = clientDate;
                        await LoadDataAsync();
                        StateHasChanged();
                    }
                }
            }
            catch
            {
                // Ignore when prerendering or in bUnit testing
            }
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        var weeklyMenuService = ServiceProvider.GetService<WeeklyMenuService>();
        if (weeklyMenuService != null)
        {
            mealPlan = await weeklyMenuService.GetHomeMealPlanAsync(currentLocalToday);
        }
        isLoading = false;
    }

    private string GetFormattedDateSubtitle()
    {
        var dayName = CalendarWeek.GetSwedishDayName(currentLocalToday);
        var monthDate = currentLocalToday.ToString("d MMMM", SwedishCulture);
        var week = CalendarWeek.FromDate(currentLocalToday);
        return $"{dayName} {monthDate} · Vecka {week.IsoWeek}";
    }

    private async Task StartMidnightWatcherAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        while (!token.IsCancellationRequested)
        {
            try
            {
                await timer.WaitForNextTickAsync(token);
                var localDateProvider = ServiceProvider.GetService<ILocalDateProvider>() ?? new SwedishLocalDateProvider();
                var latestToday = localDateProvider.GetLocalToday();
                if (latestToday != currentLocalToday)
                {
                    currentLocalToday = latestToday;
                    await LoadDataAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                // Defensive
            }
        }
    }

    public void Dispose()
    {
        _midnightWatcherCts?.Cancel();
        _midnightWatcherCts?.Dispose();
    }
}
