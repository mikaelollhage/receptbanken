@page "/inkopslista"
@implements IAsyncDisposable
@inject ShoppingListService ShoppingListService
@inject RecipeService RecipeService
@inject ServingCalculator ServingCalculator
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JSRuntime
@inject ILogger<ShoppingPlaceholder> Logger

<PageTitle>Inköpslista — Receptbanken</PageTitle>

@{
    var uncheckedItems = items.Where(x => !x.IsChecked).ToList();
    var checkedItems = items.Where(x => x.IsChecked).ToList();
}

<div class="shopping-page-container @(isShoppingMode ? "is-shopping-mode" : "")">
    @if (isShoppingMode)
    {
        <div class="shopping-mode-topbar" role="region" aria-label="Handlingsläge">
            <div class="shopping-mode-topbar-info">
                <h1 class="shopping-mode-title">🛒 Inköpslista</h1>
                <span class="shopping-mode-count" aria-live="polite">
                    <strong>@uncheckedItems.Count</strong> kvar att handla
                </span>
            </div>
            <button type="button"
                    id="shopping-exit-mode-btn"
                    class="btn-secondary-custom shopping-mode-exit-btn"
                    @onclick="ExitShoppingModeAsync">
                ✕ Avsluta handlingsläge
            </button>
        </div>
    }
    else
    {
        <div class="page-header shopping-page-header">
            <div>
                <h1 class="page-title">🛒 Inköpslista</h1>
                @if (items.Count > 0)
                {
                    <p class="shopping-header-counts" aria-live="polite">
                        <strong>@uncheckedItems.Count</strong> kvar att handla · <span>@checkedItems.Count klara</span>
                    </p>
                }
                else
                {
                    <p class="page-subtitle shopping-page-subtitle">Sammanställ råvaror från dina recept eller lägg till egna varor.</p>
                }
            </div>

            <div class="shopping-header-actions">
                <button type="button"
                        id="shopping-enter-mode-btn"
                        class="btn-primary-custom shopping-mode-enter-btn"
                        @onclick="EnterShoppingModeAsync">
                    <span>🛒 Handla</span>
                </button>

                @if (items.Count > 0)
                {
                    <button type="button"
                            class="btn-danger-custom shopping-clear-all-btn"
                            @onclick="@(() => showClearAllConfirm = true)">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Error" />
                        <span>Töm hela listan</span>
                    </button>
                }
            </div>
        </div>
    }

    <ConfirmDialog IsVisible="showClearAllConfirm"
                   Title="Töm inköpslistan"
                   Message="Är du säker på att du vill ta bort alla varor från inköpslistan?"
                   ConfirmText="Ja, töm listan"
                   CancelText="Avbryt"
                   OnConfirm="ConfirmClearAll"
                   OnCancel="@(() => showClearAllConfirm = false)" />

    <WeeklyMenuShoppingPreview IsVisible="showWeeklyMenuPreview"
                               InitialWeekDate="weeklyMenuPreviewDate"
                               ReferenceToday="GetReferenceToday()"
                               AllowWeekNavigation="true"
                               OnCancel="@(() => showWeeklyMenuPreview = false)"
                               OnConfirmed="HandleWeeklyMenuAdditionsConfirmedAsync" />

    <RecipePickerModal IsVisible="showRecipePicker"
                       Recipes="recipes"
                       Categories="categories"
                       SelectedRecipeId="selectedRecipe?.Id"
                       AllowClear="false"
                       Title="Välj recept att handla för"
                       OnSelected="HandleRecipePicked"
                       OnCancel="CloseRecipePicker" />

    <RecipeShoppingPreviewModal IsVisible="showRecipePreview"
                               RecipeId="selectedRecipe?.Id ?? 0"
                               Servings="selectedRecipeServings"
                               OnCancel="@(() => showRecipePreview = false)"
                               OnConfirmed="HandleRecipeShoppingAdditionsConfirmedAsync" />

    <!-- Snabbinmatning och infällbart receptval -->
    <div class="detail-card shopping-quick-add-card">
        <div class="shopping-quick-add-row">
            <input id="shopping-manual-input"
                   @ref="manualInputElement"
                   type="text"
                   class="form-input-custom shopping-manual-input"
                   placeholder="Lägg till vara, t.ex. 1,5 l mjölk..."
                   enterkeyhint="done"
                   aria-label="Lägg till vara manuellt"
                   @bind="ManualInput"
                   @bind:event="oninput"
                   @onkeydown="HandleManualKeyDown" />
            <button type="button"
                    id="shopping-add-manual-btn"
                    class="btn-primary-custom shopping-add-btn"
                    @onclick="AddManualItem">
                + Lägg till
            </button>
        </div>

        <ContextualFeedback State="manualAddFeedback" CssClass="shopping-manual-feedback" />

        @if (!isShoppingMode)
        {
            <div class="shopping-recipe-expander">
                <div class="shopping-source-toggles-row">
                    <button type="button"
                            id="shopping-recipe-toggle-btn"
                            class="btn-secondary-custom shopping-recipe-toggle"
                            aria-haspopup="dialog"
                            @onclick="OpenRecipePicker">
                        <span>📖 Lägg till från recept</span>
                    </button>

                    <button type="button"
                            id="shopping-weekly-menu-btn"
                            class="btn-secondary-custom shopping-weekly-menu-toggle"
                            aria-haspopup="dialog"
                            @onclick="OpenWeeklyMenuPreview">
                        <span>📅 Lägg till från veckomeny</span>
                    </button>
                </div>

                @if (selectedRecipe != null)
                {
                    <div class="shopping-recipe-panel shopping-recipe-selected-panel" role="region" aria-label="Valt recept">
                        <div class="shopping-selected-recipe-header">
                            <span class="shopping-selected-recipe-title">
                                🥘 <strong>@selectedRecipe.Title</strong>
                            </span>
                            <button type="button"
                                    id="shopping-change-recipe-btn"
                                    class="btn-secondary-custom shopping-change-recipe-btn"
                                    disabled="@showRecipePreview"
                                    @onclick="OpenRecipePicker">
                                Byt recept…
                            </button>
                        </div>

                        <div class="form-group shopping-servings-group">
                            <label class="form-label" for="shopping-recipe-servings">Antal portioner att handla för</label>
                            <div class="shopping-servings-input-wrap">
                                <input id="shopping-recipe-servings"
                                       type="number"
                                       min="1"
                                       max="100"
                                       class="form-input-custom shopping-recipe-servings-input"
                                       disabled="@showRecipePreview"
                                       @bind="selectedRecipeServings" />
                                <span class="shopping-servings-unit">@selectedRecipe.ServingsUnit</span>
                            </div>
                        </div>

                        <div class="shopping-selected-recipe-actions">
                            <button type="button"
                                    id="shopping-add-recipe-btn"
                                    class="btn-primary-custom shopping-add-recipe-submit"
                                    disabled="@showRecipePreview"
                                    @onclick="OpenRecipePreview">
                                <span>🛒 Lägg till ingredienser…</span>
                            </button>
                            <button type="button"
                                    id="shopping-cancel-recipe-btn"
                                    class="btn-secondary-custom shopping-cancel-recipe-btn"
                                    disabled="@showRecipePreview"
                                    @onclick="CancelSelectedRecipe">
                                Avbryt
                            </button>
                        </div>
                    </div>
                }

                <ContextualFeedback State="recipeAddFeedback" CssClass="shopping-recipe-feedback" />
            </div>
        }
    </div>

    <!-- Huvudlista: Att handla & Klart -->
    <div class="detail-card shopping-list-card">
        <div class="detail-card-title shopping-section-header">
            <span>Att handla (@uncheckedItems.Count)</span>
            @if (items.Count > 0)
            {
                <span class="shopping-section-subcount">
                    @checkedItems.Count av @items.Count klara
                </span>
            }
        </div>

        <ContextualFeedback State="listFeedback" CssClass="shopping-list-feedback" />
        <ContextualFeedback State="undoCheckFeedback"
                            CssClass="shopping-undo-feedback"
                            ActionText="Ångra"
                            OnAction="UndoLastCheckedItemAsync" />

        @if (isLoading)
        {
            <div class="shopping-loading-wrap">
                <FluentProgressRing />
            </div>
        }
        else if (items.Count == 0)
        {
            <div class="shopping-empty-state">
                <div class="shopping-empty-icon" aria-hidden="true">🛍️</div>
                <p class="shopping-empty-title">Inköpslistan är tom</p>
                <p class="shopping-empty-desc">Skriv in en vara i fältet ovan eller lägg till ingredienser direkt från ett recept.</p>
            </div>
        }
        else
        {
            @if (uncheckedItems.Count == 0)
            {
                <div class="shopping-all-checked-banner" role="status">
                    <span>🎉 Alla varor i listan är klara!</span>
                </div>
            }
            else
            {
                <ul class="ingredient-list shopping-items-list shopping-unchecked-list" aria-label="Att handla">
                    @for (int idx = 0; idx < uncheckedItems.Count; idx++)
                    {
                        var itemIndex = idx;
                        var item = uncheckedItems[itemIndex];
                        var rowDragClass = GetRowDragCssClass(item.Id, itemIndex, uncheckedItems);

                        <li @key="item.Id"
                            class="ingredient-item shopping-item-row @(!isShoppingMode && editingItemId == item.Id ? "is-editing" : "") @rowDragClass"
                            data-item-id="@item.Id"
                            @ondragover="@(() => HandleDragOverItem(item.Id))"
                            @ondragover:preventDefault="true"
                            @ondragenter="@(() => HandleDragEnterItem(item.Id))"
                            @ondragleave="@(() => HandleDragLeaveItem(item.Id))"
                            @ondrop="@(() => HandleDropOnItemAsync(item.Id))">
                            @if (!isShoppingMode && editingItemId == item.Id)
                            {
                                <div class="shopping-edit-panel">
                                    <div class="shopping-edit-fields">
                                        <input type="text"
                                               inputmode="decimal"
                                               class="form-input-custom shopping-edit-qty"
                                               placeholder="Mängd"
                                               aria-label="Mängd"
                                               @bind="editQuantityText"
                                               @onkeydown="@(e => HandleEditKeyDown(e, item.Id))" />
                                        <input type="text"
                                               class="form-input-custom shopping-edit-unit"
                                               placeholder="Enhet"
                                               aria-label="Enhet"
                                               @bind="editUnit"
                                               @onkeydown="@(e => HandleEditKeyDown(e, item.Id))" />
                                        <input type="text"
                                               class="form-input-custom shopping-edit-name"
                                               placeholder="Vara"
                                               aria-label="Varans namn"
                                               @bind="editName"
                                               @onkeydown="@(e => HandleEditKeyDown(e, item.Id))" />
                                        <input type="text"
                                               class="form-input-custom shopping-edit-comment"
                                               placeholder="Kommentar (valfritt)"
                                               aria-label="Kommentar"
                                               @bind="editComment"
                                               @onkeydown="@(e => HandleEditKeyDown(e, item.Id))" />
                                    </div>
                                    <div class="shopping-edit-reorder-row">
                                        <button type="button"
                                                class="btn-secondary-custom shopping-move-up-btn"
                                                disabled="@(itemIndex == 0)"
                                                aria-label="@($"Flytta {item.Name} uppåt")"
                                                @onclick="@(() => MoveItemByOffsetAsync(item.Id, -1))">
                                            ↑ Flytta upp
                                        </button>
                                        <button type="button"
                                                class="btn-secondary-custom shopping-move-down-btn"
                                                disabled="@(itemIndex >= uncheckedItems.Count - 1)"
                                                aria-label="@($"Flytta {item.Name} nedåt")"
                                                @onclick="@(() => MoveItemByOffsetAsync(item.Id, 1))">
                                            ↓ Flytta ned
                                        </button>
                                    </div>
                                    <div class="shopping-edit-actions">
                                        <div class="shopping-edit-actions-left">
                                            <button type="button"
                                                    class="btn-primary-custom shopping-save-edit-btn"
                                                    @onclick="@(() => SaveEdit(item.Id))">
                                                Spara
                                            </button>
                                            <button type="button"
                                                    class="btn-secondary-custom shopping-cancel-edit-btn"
                                                    @onclick="CancelEdit">
                                                Avbryt
                                            </button>
                                        </div>
                                        <button type="button"
                                                class="btn-danger-custom shopping-delete-in-edit-btn"
                                                title="@($"Ta bort {item.Name}")"
                                                aria-label="@($"Ta bort {item.Name}")"
                                                @onclick="@(() => DeleteItem(item.Id))">
                                            🗑 Ta bort
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="shopping-row-main-line">
                                    <div class="shopping-row-check-target"
                                         role="checkbox"
                                         aria-checked="false"
                                         tabindex="0"
                                         aria-label="@($"Markera {item.RawText} som klar")"
                                         @onclick="@(() => SetItemChecked(item, true))"
                                         @onkeydown="@(e => HandleRowKeyDown(e, item, true))">
                                        <div class="shopping-item-body">
                                            <div class="shopping-item-text">
                                                @if (item.Quantity.HasValue)
                                                {
                                                    <span class="shopping-item-qty">@($"{ServingCalculator.FormatQuantityRange(item.Quantity, item.QuantityMax)} ")</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.Unit))
                                                {
                                                    <span class="shopping-item-unit">@($"{item.Unit.Trim()} ")</span>
                                                }
                                                <span class="shopping-item-name">@item.Name</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(item.Comment))
                                            {
                                                <div class="shopping-item-comment">@item.Comment</div>
                                            }
                                        </div>
                                    </div>
                                    <div class="shopping-row-actions">
                                        @if (!isShoppingMode)
                                        {
                                            <button type="button"
                                                    class="btn-secondary-custom shopping-edit-btn"
                                                    title="@($"Redigera {item.Name}")"
                                                    aria-label="@($"Redigera {item.Name}")"
                                                    @onclick="@(() => StartEdit(item))"
                                                    @onclick:stopPropagation="true">
                                                ✏️
                                            </button>
                                        }
                                        <button type="button"
                                                class="shopping-drag-handle @(reorderMenuOpenItemId == item.Id ? "is-reorder-active" : "")"
                                                draggable="true"
                                                title="@($"Dra för att flytta {item.Name}, eller tryck för flyttval")"
                                                aria-label="@($"Ändra ordning för {item.Name}")"
                                                aria-expanded="@(reorderMenuOpenItemId == item.Id ? "true" : "false")"
                                                @ondragstart="@(() => HandleDragStartItem(item.Id))"
                                                @ondragend="HandleDragEndAsync"
                                                @onclick="@(() => ToggleReorderMenu(item.Id))"
                                                @onclick:stopPropagation="true"
                                                @onkeydown="@(e => HandleDragHandleKeyDownAsync(e, item.Id))">
                                            ⠿
                                        </button>
                                    </div>
                                </div>

                                @if (reorderMenuOpenItemId == item.Id)
                                {
                                    <div class="shopping-item-reorder-bar" role="group" aria-label="@($"Flytta {item.Name}")">
                                        <button type="button"
                                                class="btn-secondary-custom shopping-move-up-btn"
                                                disabled="@(itemIndex == 0)"
                                                aria-label="@($"Flytta {item.Name} uppåt")"
                                                @onclick="@(() => MoveItemByOffsetAsync(item.Id, -1))">
                                            ↑ Flytta upp
                                        </button>
                                        <button type="button"
                                                class="btn-secondary-custom shopping-move-down-btn"
                                                disabled="@(itemIndex >= uncheckedItems.Count - 1)"
                                                aria-label="@($"Flytta {item.Name} nedåt")"
                                                @onclick="@(() => MoveItemByOffsetAsync(item.Id, 1))">
                                            ↓ Flytta ned
                                        </button>
                                    </div>
                                }
                            }
                        </li>
                    }
                </ul>
            }

            @if (checkedItems.Count > 0)
            {
                <div class="shopping-checked-section">
                    <div class="shopping-checked-header">
                        <h3 class="shopping-checked-title">
                            Klart (@checkedItems.Count)
                        </h3>
                        @if (!isShoppingMode)
                        {
                            <button type="button"
                                    class="btn-secondary-custom shopping-clear-checked-btn"
                                    @onclick="ClearCheckedItems">
                                <FluentIcon Value="@(new Icons.Regular.Size16.CheckmarkCircle())" Color="Color.Neutral" />
                                <span>Rensa klara (@checkedItems.Count)</span>
                            </button>
                        }
                    </div>
                    <ul class="ingredient-list shopping-items-list shopping-checked-list" aria-label="Klart">
                        @foreach (var item in checkedItems)
                        {
                            <li @key="item.Id"
                                class="ingredient-item checked shopping-item-row"
                                data-item-id="@item.Id">
                                <div class="shopping-row-check-target"
                                     role="checkbox"
                                     aria-checked="true"
                                     tabindex="0"
                                     aria-label="@($"Återställ {item.RawText} till att handla")"
                                     @onclick="@(() => SetItemChecked(item, false))"
                                     @onkeydown="@(e => HandleRowKeyDown(e, item, false))">
                                    <div class="shopping-item-body">
                                        <span class="shopping-checked-text">@item.RawText</span>
                                        @if (!string.IsNullOrWhiteSpace(item.Comment))
                                        {
                                            <div class="shopping-checked-comment">@item.Comment</div>
                                        }
                                    </div>
                                </div>
                                @if (!isShoppingMode)
                                {
                                    <div class="shopping-row-actions">
                                        <button type="button"
                                                class="btn-danger-custom shopping-delete-btn"
                                                title="@($"Ta bort {item.RawText}")"
                                                aria-label="@($"Ta bort {item.RawText}")"
                                                @onclick="@(() => DeleteItem(item.Id))"
                                                @onclick:stopPropagation="true">
                                            ✕
                                        </button>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<ShoppingListItem> items = new();
    private List<Recipe> recipes = new();
    private List<Category> categories = new();
    private bool isLoading = true;
    private bool isShoppingMode = false;
    private bool showClearAllConfirm = false;
    private bool showRecipePicker = false;
    private bool showRecipePreview = false;
    private bool showWeeklyMenuPreview = false;
    private Recipe? selectedRecipe;
    private int selectedRecipeServings = 4;
    private DateOnly weeklyMenuPreviewDate;
    private bool _isDisposed;
    private bool _isDragging;
    private bool _hasPendingRealtimeUpdate;
    private long _lastLoadedVersion;
    private long _lastLoadedOrderingVersion;
    private long? _dragStartOrderingVersion;
    private DotNetObjectReference<ShoppingPlaceholder>? _dotNetRef;
    private ElementReference manualInputElement;

    private string manualInput = string.Empty;
    private string ManualInput
    {
        get => manualInput;
        set
        {
            manualInput = value;
            if (manualAddFeedback.HasMessage)
            {
                manualAddFeedback.Clear();
            }
        }
    }


    private int? editingItemId;
    private string editQuantityText = string.Empty;
    private string? editUnit;
    private string editName = string.Empty;
    private string? editComment;

    private int? undoCheckedItemId;
    private ShoppingListItem? undoDeletedItemSnapshot;
    private int? draggedItemId;
    private int? dragOverItemId;
    private bool _draggedItemHadReorderOpen;
    private int? reorderMenuOpenItemId;
    private int? _pendingFocusItemId;
    private int? _pendingScrollItemId;

    private readonly FeedbackState manualAddFeedback = new();
    private readonly FeedbackState recipeAddFeedback = new();
    private readonly FeedbackState listFeedback = new();
    private readonly FeedbackState undoCheckFeedback = new();

    protected override async Task OnInitializedAsync()
    {
        ShoppingListService.OnChanged += HandleShoppingListChanged;
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isDisposed)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("receptbanken.registerShoppingSyncListeners", _dotNetRef);
            }
            catch
            {
                // Ignored when running in test host or if circuit disconnects before JS interop completes.
            }
        }

        if (_pendingFocusItemId.HasValue && !_isDisposed)
        {
            var focusTarget = _pendingFocusItemId.Value;
            _pendingFocusItemId = null;
            _pendingScrollItemId = null;
            try
            {
                await JSRuntime.InvokeVoidAsync("receptbanken.focusAndScrollShoppingItemHandle", focusTarget);
            }
            catch
            {
                // Ignored when running in test host or if circuit disconnects before JS interop completes.
            }
        }
        else if (_pendingScrollItemId.HasValue && !_isDisposed)
        {
            var scrollTarget = _pendingScrollItemId.Value;
            _pendingScrollItemId = null;
            try
            {
                await JSRuntime.InvokeVoidAsync("receptbanken.scrollShoppingItemIntoViewIfNeeded", scrollTarget);
            }
            catch
            {
                // Ignored when running in test host or if circuit disconnects before JS interop completes.
            }
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        _lastLoadedVersion = ShoppingListService.CurrentVersion;
        _lastLoadedOrderingVersion = ShoppingListService.CurrentOrderingVersion;
        items = await ShoppingListService.GetItemsAsync();
        recipes = await RecipeService.GetRecipesAsync();
        try
        {
            var categoryService = ServiceProvider.GetService(typeof(CategoryService)) as CategoryService;
            if (categoryService != null)
            {
                var categoryDtos = await categoryService.GetCategoriesAsync();
                categories = categoryDtos
                    .Select(c => new Category { Id = c.Id, Name = c.Name, ColorHex = c.ColorHex })
                    .ToList();
            }
            else
            {
                categories = recipes
                    .SelectMany(r => r.RecipeCategories)
                    .Select(rc => rc.Category)
                    .Where(c => c != null)
                    .GroupBy(c => c!.Id)
                    .Select(g => g.First()!)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Kunde inte läsa in kategorier för receptväljaren i inköpslistan.");
        }
        isLoading = false;
    }

    private async Task ReloadItemsAsync()
    {
        _lastLoadedVersion = ShoppingListService.CurrentVersion;
        _lastLoadedOrderingVersion = ShoppingListService.CurrentOrderingVersion;
        items = await ShoppingListService.GetItemsAsync();

        if (editingItemId.HasValue && items.All(x => x.Id != editingItemId.Value || x.IsChecked))
        {
            editingItemId = null;
        }

        if (reorderMenuOpenItemId.HasValue && items.All(x => x.Id != reorderMenuOpenItemId.Value || x.IsChecked))
        {
            reorderMenuOpenItemId = null;
        }

        if (undoCheckedItemId.HasValue)
        {
            var undoTarget = items.FirstOrDefault(x => x.Id == undoCheckedItemId.Value);
            if (undoTarget == null || !undoTarget.IsChecked)
            {
                undoCheckedItemId = null;
                undoCheckFeedback.Clear();
            }
        }
        else if (undoDeletedItemSnapshot != null)
        {
            if (items.Any(x => x.Id == undoDeletedItemSnapshot.Id))
            {
                undoDeletedItemSnapshot = null;
                undoCheckFeedback.Clear();
            }
        }
    }

    private void HandleShoppingListChanged(long newVersion)
    {
        if (_isDisposed)
            return;

        _ = InvokeAsync(async () =>
        {
            if (_isDisposed || newVersion <= _lastLoadedVersion)
                return;

            // Freeze DOM re-rendering while an active drag gesture is in progress (DEL F7).
            if (_isDragging)
            {
                _hasPendingRealtimeUpdate = true;
                return;
            }

            try
            {
                await ReloadItemsAsync();
                StateHasChanged();
            }
            catch (Exception ex) when (!_isDisposed)
            {
                Logger.LogWarning(ex, "Kunde inte uppdatera inköpslistan vid realtidshändelse.");
            }
        });
    }

    private async Task EnterShoppingModeAsync()
    {
        isShoppingMode = true;
        editingItemId = null;
        showRecipePicker = false;
        showRecipePreview = false;
        selectedRecipe = null;
        showWeeklyMenuPreview = false;
        showClearAllConfirm = false;

        try
        {
            await JSRuntime.InvokeAsync<bool>("receptbanken.requestWakeLock");
        }
        catch
        {
            // Optional progressive enhancement; never required for shopping mode (DEL C6).
        }
    }

    private async Task ExitShoppingModeAsync()
    {
        isShoppingMode = false;

        try
        {
            await JSRuntime.InvokeVoidAsync("receptbanken.releaseWakeLock");
        }
        catch
        {
            // Ignore if Wake Lock is unsupported or unavailable.
        }
    }

    private string GetRowDragCssClass(int itemId, int itemIndex, List<ShoppingListItem> uncheckedItems)
    {
        var classes = new List<string>(3);
        if (draggedItemId == itemId)
        {
            classes.Add("is-dragging");
        }

        if (dragOverItemId == itemId && draggedItemId.HasValue && draggedItemId.Value != itemId)
        {
            classes.Add("drag-over");
            var sourceIndex = uncheckedItems.FindIndex(x => x.Id == draggedItemId.Value);
            if (sourceIndex > itemIndex)
            {
                classes.Add("drag-over-above");
            }
            else if (sourceIndex >= 0 && sourceIndex < itemIndex)
            {
                classes.Add("drag-over-below");
            }
        }

        return string.Join(" ", classes);
    }

    private void HandleDragStartItem(int itemId)
    {
        _isDragging = true;
        draggedItemId = itemId;
        dragOverItemId = null;
        _dragStartOrderingVersion = _lastLoadedOrderingVersion;
        _draggedItemHadReorderOpen = (reorderMenuOpenItemId == itemId);
    }

    private void HandleDragOverItem(int itemId)
    {
        if (draggedItemId.HasValue && draggedItemId.Value != itemId)
        {
            dragOverItemId = itemId;
        }
    }

    private void HandleDragEnterItem(int itemId)
    {
        if (draggedItemId.HasValue && draggedItemId.Value != itemId)
        {
            dragOverItemId = itemId;
        }
    }

    private void HandleDragLeaveItem(int itemId)
    {
        if (dragOverItemId == itemId)
        {
            dragOverItemId = null;
        }
    }

    private async Task HandleDropOnItemAsync(int targetItemId)
    {
        if (!draggedItemId.HasValue)
            return;

        var sourceItemId = draggedItemId.Value;
        await DropItemOnTargetAsync(sourceItemId, targetItemId);
    }

    private async Task HandleDragEndAsync()
    {
        _isDragging = false;
        draggedItemId = null;
        dragOverItemId = null;
        _dragStartOrderingVersion = null;
        _draggedItemHadReorderOpen = false;

        if (_hasPendingRealtimeUpdate)
        {
            _hasPendingRealtimeUpdate = false;
            await ReloadItemsAsync();
        }
    }

    [JSInvokable]
    public Task OnTouchDragStartAsync(int itemId)
    {
        if (_isDisposed)
            return Task.CompletedTask;

        _isDragging = true;
        draggedItemId = itemId;
        dragOverItemId = null;
        _dragStartOrderingVersion = _lastLoadedOrderingVersion;
        _draggedItemHadReorderOpen = (reorderMenuOpenItemId == itemId);
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnTouchDropAsync(int sourceItemId, int targetItemId)
    {
        if (_isDisposed)
            return;

        await InvokeAsync(async () =>
        {
            if (_isDisposed)
                return;

            await DropItemOnTargetAsync(sourceItemId, targetItemId);
            StateHasChanged();
        });
    }

    [JSInvokable]
    public async Task OnTouchDragCancelAsync()
    {
        if (_isDisposed)
            return;

        await InvokeAsync(async () =>
        {
            if (_isDisposed)
                return;

            await HandleDragEndAsync();
            StateHasChanged();
        });
    }

    private async Task DropItemOnTargetAsync(int sourceItemId, int targetItemId)
    {
        var expectedVersion = _dragStartOrderingVersion ?? _lastLoadedOrderingVersion;
        var hadReorderOpen = _draggedItemHadReorderOpen;
        _isDragging = false;
        draggedItemId = null;
        dragOverItemId = null;
        _dragStartOrderingVersion = null;
        _draggedItemHadReorderOpen = false;
        _hasPendingRealtimeUpdate = false;

        if (sourceItemId == targetItemId)
        {
            await ReloadItemsAsync();
            return;
        }

        var uncheckedList = items.Where(x => !x.IsChecked).ToList();
        var targetIndex = uncheckedList.FindIndex(x => x.Id == targetItemId);
        if (targetIndex < 0)
        {
            reorderMenuOpenItemId = null;
            await ReloadItemsAsync();
            return;
        }

        await ExecuteMoveItemAsync(sourceItemId, targetIndex, expectedVersion, hadReorderOpen);
    }

    private void ToggleReorderMenu(int itemId)
    {
        reorderMenuOpenItemId = reorderMenuOpenItemId == itemId ? null : itemId;
    }

    private async Task HandleDragHandleKeyDownAsync(KeyboardEventArgs e, int itemId)
    {
        if (e.Key == "ArrowUp")
        {
            if (reorderMenuOpenItemId == itemId)
            {
                await MoveItemByOffsetAsync(itemId, -1, fromKeyboard: true);
            }
        }
        else if (e.Key == "ArrowDown")
        {
            if (reorderMenuOpenItemId == itemId)
            {
                await MoveItemByOffsetAsync(itemId, 1, fromKeyboard: true);
            }
        }
        else if (e.Key == "Escape" && reorderMenuOpenItemId == itemId)
        {
            reorderMenuOpenItemId = null;
        }
    }

    private async Task MoveItemByOffsetAsync(int itemId, int offset, bool fromKeyboard = false)
    {
        var uncheckedList = items.Where(x => !x.IsChecked).ToList();
        var currentIndex = uncheckedList.FindIndex(x => x.Id == itemId);
        if (currentIndex < 0)
            return;

        var targetIndex = currentIndex + offset;
        if (targetIndex < 0 || targetIndex >= uncheckedList.Count)
            return;

        bool preserveReorderOpen = editingItemId != itemId;
        bool moved = await ExecuteMoveItemAsync(itemId, targetIndex, _lastLoadedOrderingVersion, preserveReorderOpen);
        if (moved && preserveReorderOpen && reorderMenuOpenItemId == itemId)
        {
            if (fromKeyboard)
            {
                _pendingFocusItemId = itemId;
                _pendingScrollItemId = itemId;
            }
            else
            {
                _pendingFocusItemId = null;
                _pendingScrollItemId = itemId;
            }
        }
    }

    private async Task<bool> ExecuteMoveItemAsync(
        int itemId,
        int targetIndex,
        long expectedOrderingVersion,
        bool preserveReorderOpen)
    {
        listFeedback.Clear();
        try
        {
            var result = await ShoppingListService.MoveItemAsync(itemId, targetIndex, expectedOrderingVersion);
            reorderMenuOpenItemId = preserveReorderOpen &&
                (result.Status == ShoppingListReorderStatus.Success || result.Status == ShoppingListReorderStatus.NoChange)
                ? itemId
                : null;

            await ReloadItemsAsync();

            if (result.IsConflict)
            {
                listFeedback.ShowWarning(result.ErrorMessage ?? "Ordningen ändrades på en annan enhet. Listan har uppdaterats.");
                return false;
            }
            else if (result.Status == ShoppingListReorderStatus.InvalidOperation)
            {
                listFeedback.ShowWarning(result.ErrorMessage ?? "Kunde inte ändra varans plats eftersom listan har ändrats.");
                return false;
            }

            return result.Status == ShoppingListReorderStatus.Success;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fel vid omsortering av vara {ItemId} i inköpslistan.", itemId);
            reorderMenuOpenItemId = null;
            await ReloadItemsAsync();
            listFeedback.ShowError("Kunde inte spara den nya sorteringsordningen. Försök igen.");
            return false;
        }
    }

    /// <summary>
    /// Invoked from browser visibility/online/reconnect listeners when the mobile device
    /// wakes up or regains its connection, ensuring the latest server state is displayed.
    /// </summary>
    [JSInvokable]
    public async Task OnClientResumedAsync()
    {
        if (_isDisposed)
            return;

        await InvokeAsync(async () =>
        {
            if (_isDisposed)
                return;

            try
            {
                await ReloadItemsAsync();
                StateHasChanged();
            }
            catch (Exception ex) when (!_isDisposed)
            {
                Logger.LogWarning(ex, "Kunde inte läsa om inköpslistan vid återanslutning.");
            }
        });
    }

