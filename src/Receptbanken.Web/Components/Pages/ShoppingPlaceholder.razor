    private async Task SetItemChecked(ShoppingListItem item, bool isChecked)
    {
        listFeedback.Clear();
        try
        {
            var itemName = item.Name;
            var itemId = item.Id;
            var existed = await ShoppingListService.SetCheckedAsync(itemId, isChecked);
            await ReloadItemsAsync();

            if (!existed)
            {
                if (undoCheckedItemId == itemId)
                {
                    undoCheckedItemId = null;
                    undoCheckFeedback.Clear();
                }
                listFeedback.ShowWarning("Varan fanns inte längre kvar i inköpslistan.");
                return;
            }

            if (isChecked)
            {
                undoDeletedItemSnapshot = null;
                undoCheckedItemId = itemId;
                undoCheckFeedback.ShowSuccess($"\"{itemName}\" markerad som klar.");
            }
            else if (undoCheckedItemId == itemId)
            {
                undoCheckedItemId = null;
                undoCheckFeedback.Clear();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fel vid markering av vara i inköpslistan.");
            listFeedback.ShowError("Kunde inte uppdatera varan. Kontrollera anslutningen och försök igen.");
        }
    }

    private async Task UndoLastCheckedItemAsync()
    {
        if (undoDeletedItemSnapshot != null)
        {
            var snapshotToRestore = undoDeletedItemSnapshot;
            undoDeletedItemSnapshot = null;
            undoCheckedItemId = null;
            undoCheckFeedback.Clear();
            listFeedback.Clear();

            try
            {
                var restored = await ShoppingListService.RestoreDeletedItemAsync(snapshotToRestore);
                await ReloadItemsAsync();

                if (!restored)
                {
                    listFeedback.ShowWarning("Varan kunde inte återställas.");
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Fel vid ångra borttagning av vara i inköpslistan.");
                listFeedback.ShowError("Kunde inte återställa varan. Försök igen.");
            }

            return;
        }

        if (!undoCheckedItemId.HasValue)
            return;

        var idToRestore = undoCheckedItemId.Value;
        undoCheckedItemId = null;
        undoCheckFeedback.Clear();
        listFeedback.Clear();

        try
        {
            var existed = await ShoppingListService.SetCheckedAsync(idToRestore, false);
            await ReloadItemsAsync();

            if (!existed)
            {
                listFeedback.ShowWarning("Varan fanns inte längre kvar i inköpslistan.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fel vid ångra avbockning i inköpslistan.");
            listFeedback.ShowError("Kunde inte återställa varan. Försök igen.");
        }
    }

    private void StartEdit(ShoppingListItem item)
    {
        listFeedback.Clear();
        reorderMenuOpenItemId = null;
        editingItemId = item.Id;
        editQuantityText = ServingCalculator.FormatQuantityRange(item.Quantity, item.QuantityMax);
        editUnit = item.Unit;
        editName = item.Name;
        editComment = item.Comment;
    }

    private void CancelEdit()
    {
