    public async ValueTask DisposeAsync()
    {
        if (_isDisposed)
            return;

        _isDisposed = true;
        ShoppingListService.OnChanged -= HandleShoppingListChanged;

        var dotNetRef = _dotNetRef;
        _dotNetRef = null;

        try
        {
            if (isShoppingMode)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("receptbanken.releaseWakeLock");
                }
                catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
                {
                }
            }

            if (dotNetRef != null)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("receptbanken.unregisterShoppingSyncListeners");
                }
                catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
                {
                }
            }
        }
        finally
        {
            dotNetRef?.Dispose();
        }
    }
