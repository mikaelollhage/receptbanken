    }

    private async Task SaveEdit(int id)
    {
        if (string.IsNullOrWhiteSpace(editName))
        {
            listFeedback.ShowError("Ange ett namn på varan.");
            return;
        }

        if (!TryParseEditQuantityRange(editQuantityText, out var parsedQty, out var parsedQtyMax))
        {
            listFeedback.ShowError("Ange en giltig mängd (t.ex. 2 eller 1–2).");
            return;
        }

        listFeedback.Clear();
        try
        {
            var updated = await ShoppingListService.UpdateItemAsync(
                id,
                parsedQty,
                parsedQtyMax,
                editUnit,
                editName,
                editComment);
            editingItemId = null;
            await ReloadItemsAsync();

            if (!updated)
            {
                listFeedback.ShowWarning("Varan kunde inte uppdateras eftersom den har tagits bort.");
            }
        }
        catch (InvalidOperationException ex)
        {
            listFeedback.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fel vid uppdatering av vara i inköpslistan.");
            listFeedback.ShowError("Kunde inte spara ändringen. Försök igen.");
        }
    }

    private static bool TryParseEditQuantityRange(string? rawText, out decimal? quantity, out decimal? quantityMax)
    {
        quantity = null;
        quantityMax = null;

        if (string.IsNullOrWhiteSpace(rawText))
            return true;

        var trimmed = rawText.Trim();
        var rangeParts = trimmed.Split(new[] { '–', '—', '-' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (rangeParts.Length == 2)
        {
            if (TryParseSingleDecimal(rangeParts[0], out var minVal) &&
                TryParseSingleDecimal(rangeParts[1], out var maxVal) &&
                minVal >= 0 && maxVal >= minVal)
            {
                quantity = minVal;
                quantityMax = maxVal > minVal ? maxVal : null;
                return true;
            }
            return false;
        }

        if (rangeParts.Length == 1 && TryParseSingleDecimal(rangeParts[0], out var singleVal) && singleVal >= 0)
        {
            quantity = singleVal;
            quantityMax = null;
            return true;
        }

        return false;
    }

    private static bool TryParseSingleDecimal(string text, out decimal value)
    {
        var normalized = text.Trim().Replace(',', '.');
        return decimal.TryParse(
            normalized,
            System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture,
            out value);
    }

    private async Task DeleteItem(int id)
    {
        listFeedback.Clear();
        try
        {
            var existingItem = items.FirstOrDefault(x => x.Id == id);
            var snapshot = existingItem == null
                ? null
                : new ShoppingListItem
                {
                    Id = existingItem.Id,
                    RecipeId = existingItem.RecipeId,
                    RawText = existingItem.RawText,
                    Quantity = existingItem.Quantity,
                    QuantityMax = existingItem.QuantityMax,
                    Unit = existingItem.Unit,
                    Name = existingItem.Name,
                    Comment = existingItem.Comment,
                    IsChecked = existingItem.IsChecked,
                    SortOrder = existingItem.SortOrder,
                    Department = existingItem.Department,
                    CreatedAt = existingItem.CreatedAt
                };

            if (editingItemId == id)
            {
                editingItemId = null;
            }
            if (reorderMenuOpenItemId == id)
            {
                reorderMenuOpenItemId = null;
            }
            if (undoCheckedItemId == id)
            {
                undoCheckedItemId = null;
                undoCheckFeedback.Clear();
            }

            var deleted = await ShoppingListService.DeleteItemAsync(id);
            await ReloadItemsAsync();

            if (deleted && snapshot != null)
            {
                undoCheckedItemId = null;
                undoDeletedItemSnapshot = snapshot;
                undoCheckFeedback.ShowSuccess($"\"{snapshot.Name}\" borttagen.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fel vid borttagning av vara från inköpslistan.");
            listFeedback.ShowError("Kunde inte ta bort varan. Försök igen.");
        }
    }

