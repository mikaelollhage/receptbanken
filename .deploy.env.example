# ============================================================================
# Receptbanken — Deployment Configuration Template (.deploy.env.example)
# Copy this file to .deploy.env and fill in your Ubuntu server details.
# Do NOT commit .deploy.env to version control.
# ============================================================================

# IP address or hostname of the Ubuntu 24.04 LTS server on your LAN (e.g. home-server)
SERVER_HOST=home-server

# SSH username on the Ubuntu server (must belong to the 'docker' group, e.g. mikaelollhage)
SERVER_USER=mikaelollhage

# SSH port on the Ubuntu server
SERVER_PORT=22

# Target directory on the Ubuntu server
DEPLOY_PATH=/opt/receptbanken

# HTTP port exposed on the LAN
APP_PORT=8080

# Explicit, stable Docker named volume for persistent data (/app/data)
VOLUME_NAME=receptbanken-data

# Number of verified backup sets and previous Docker images to retain
BACKUP_RETENTION_COUNT=10
IMAGE_RETENTION_COUNT=5

# VAPID Subject for Web Push (RFC 8292). Must be a valid mailto: address or public https:// URL.
# Example: mailto:admin@example.com or https://receptbanken.example.com
VAPID_SUBJECT=mailto:admin@example.com

